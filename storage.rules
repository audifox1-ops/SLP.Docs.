rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasClaimRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    function isBootstrapAdmin() {
      return isAuthenticated() &&
             request.auth.token.email == "audifox1@gmail.com" &&
             request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isAuthenticated() &&
             (request.auth.token.admin == true ||
              hasClaimRole('admin') ||
              isBootstrapAdmin());
    }

    function isStaff() {
      return isAuthenticated() &&
             (request.auth.token.admin == true ||
              hasClaimRole('admin') ||
              hasClaimRole('staff') ||
              isBootstrapAdmin());
    }

    function isAllowedUpload() {
      return request.resource != null &&
             request.resource.size <= 15 * 1024 * 1024 &&
             request.resource.contentType != null &&
             request.resource.contentType.matches('image/.*|text/.*|application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document|application/vnd.ms-excel|application/vnd.openxmlformats-officedocument.spreadsheetml.sheet|application/octet-stream');
    }

    match /students/{studentId}/attachments/{fileName} {
      allow read: if isStaff();
      allow create, update: if isStaff() && isAllowedUpload();
      allow delete: if isAdmin();
    }

    match /payment_files/{fileName} {
      allow read: if isAdmin();
      allow create, update: if isStaff() && isAllowedUpload();
      allow delete: if isAdmin();
    }

    match /document_templates/{allPaths=**} {
      allow read: if isStaff();
      allow create, update: if isAdmin() && isAllowedUpload();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
