{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Information about a student receiving treatment",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Student's full name" },
        "birthDate": { "type": "string", "description": "Birth date in YYYY.MM.DD format" },
        "school": { "type": "string", "description": "School or kindergarten name" },
        "disabilityType": { "type": "string", "description": "Type of disability" },
        "treatmentArea": { "type": "string", "description": "Main treatment area" },
        "schedule": {
          "type": "object",
          "properties": {
            "day": { "type": "string" },
            "time": { "type": "string" },
            "frequency": { "type": "string" }
          }
        },
        "startDate": { "type": "string", "description": "Treatment start date in YYYY.MM format" },
        "therapistName": { "type": "string" },
        "voucherArea": { "type": "string" },
        "paymentDates": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of payment dates in YYYY-MM-DD format"
        }
      },
      "required": ["name", "birthDate", "school", "treatmentArea"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Collection of students"
    },
    "/payment_records/{recordId}": {
      "schema": {
        "type": "object",
        "properties": {
          "studentName": { "type": "string" },
          "transactionDate": { "type": "string" },
          "amount": { "type": ["number", "string"] },
          "treatmentArea": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["studentName", "transactionDate", "amount", "treatmentArea"]
      },
      "description": "Collection of payment records from uploaded files"
    },
    "/document_templates/monthly_journal": {
      "schema": {
        "type": "object",
        "properties": {
          "fileName": { "type": "string" },
          "fileUrl": { "type": "string" },
          "fileType": { "type": "string" },
          "fileSize": { "type": "number" },
          "uploadedAtMs": { "type": "number" },
          "storageMode": {
            "type": "string",
            "description": "firestore-chunks for current template sample uploads, firebase-storage for older uploaded files"
          },
          "chunkUploadId": { "type": "string" },
          "chunkCount": { "type": "number" },
          "chunkSize": { "type": "number" },
          "applyMode": {
            "type": "string",
            "description": "hwp-template for primary HWP samples, hwpx-template/docx-template for automatic placeholder replacement, sample-reference for reference-only files"
          },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["fileName", "fileUrl", "fileType", "fileSize", "uploadedAtMs", "applyMode"]
      },
      "description": "Uploaded sample file metadata for monthly journal template changes"
    }
  }
}
