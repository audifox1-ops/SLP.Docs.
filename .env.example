# GEMINI_API_KEY: Required for Gemini AI API calls.
# Keep this server-side only. Do not expose it in client-side Vite env vars.
# If Google reports the key as leaked, revoke it and replace it with a new key.
GEMINI_API_KEY=

# Optional App Check for the browser client. Set after creating a reCAPTCHA v3
# App Check provider in Firebase Console.
VITE_FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=

# Optional AI API limits.
AI_MAX_PROMPT_CHARS=30000
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=12
GEMINI_ALLOWED_MODELS=gemini-2.5-flash-lite

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
