// ===============================================================
// Single Operator Data Model
// IMPORTANT:
// - The app intentionally has no in-app login because it is used by one person.
// - Firestore Rules cannot identify "one person" without authentication.
// - Only deploy these no-login rules when the app itself is protected by
//   hosting-level access control, a private network, or equivalent controls.
// - App Check can reduce abuse from non-app clients, but it is not a user
//   authorization system.
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Access Helper
    // ===============================================================

    function singleOperatorMode() {
      return true;
    }

    // ===============================================================
    // Generic Validators
    // ===============================================================

    function optionalString(data, field, maxSize) {
      let value = data.get(field, null);
      return value == null ||
             (value is string && value.size() <= maxSize);
    }

    function optionalBool(data, field) {
      let value = data.get(field, null);
      return value == null ||
             value is bool;
    }

    function optionalNumber(data, field) {
      let value = data.get(field, null);
      return value == null ||
             value is number;
    }

    function optionalTimestamp(data, field) {
      let value = data.get(field, null);
      return value == null ||
             value is timestamp;
    }

    function optionalList(data, field) {
      let value = data.get(field, null);
      return value == null ||
             value is list;
    }

    function optionalMap(data, field) {
      let value = data.get(field, null);
      return value == null ||
             value is map;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidStudent(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.birthDate is string && data.birthDate.size() < 20 &&
             data.school is string && data.school.size() < 100 &&
             data.treatmentArea is string && data.treatmentArea.size() < 100 &&
             optionalString(data, 'disabilityType', 100) &&
             optionalString(data, 'therapistName', 100) &&
             optionalString(data, 'guardianName', 100) &&
             optionalString(data, 'guardianPhone', 30) &&
             optionalString(data, 'guardianRelation', 50) &&
             optionalBool(data, 'messageConsent') &&
             optionalString(data, 'scheduleDay', 20) &&
             optionalString(data, 'scheduleTime', 50) &&
             optionalString(data, 'scheduleFrequency', 20) &&
             optionalList(data, 'scheduleTimeHistory') &&
             optionalString(data, 'referenceData', 200000) &&
             optionalString(data, 'referenceFileName', 255) &&
             optionalString(data, 'specialNotes', 20000) &&
             optionalList(data, 'attachments');
    }

    function isValidPaymentRecord(data) {
      return data.studentName is string && data.studentName.size() > 0 && data.studentName.size() < 100 &&
             data.transactionDate is string && data.transactionDate.size() > 0 && data.transactionDate.size() < 50 &&
             data.treatmentArea is string && data.treatmentArea.size() < 100 &&
             (data.amount is number || (data.amount is string && data.amount.size() < 50)) &&
             optionalString(data, 'transactionTime', 20) &&
             optionalTimestamp(data, 'createdAt') &&
             optionalTimestamp(data, 'updatedAt');
    }

    function isValidAnnualPlan(data) {
      return data.currentLevel is list &&
             data.longTermGoals is list &&
             data.monthlyGoals is list &&
             optionalNumber(data, 'startYear') &&
             optionalNumber(data, 'startMonth') &&
             optionalNumber(data, 'endYear') &&
             optionalNumber(data, 'endMonth') &&
             optionalString(data, 'therapyPeriod', 100) &&
             optionalMap(data, 'studentOverrides');
    }

    function isValidMonthlyJournal(data) {
      return data.currentLevel is string && data.currentLevel.size() <= 10000 &&
             data.monthlyGoal is string && data.monthlyGoal.size() <= 10000 &&
             data.sessions is list &&
             data.result is string && data.result.size() <= 20000 &&
             optionalString(data, 'therapyPeriod', 100) &&
             optionalMap(data, 'studentOverrides');
    }

    function isValidDocumentHistory(data) {
      return data.docType in ['annual', 'monthly'] &&
             data.docKey is string && data.docKey.size() > 0 && data.docKey.size() < 200 &&
             data.studentName is string && data.studentName.size() > 0 && data.studentName.size() < 100 &&
             data.data is map &&
             data.createdAtMs is number &&
             optionalNumber(data, 'year') &&
             optionalNumber(data, 'month') &&
             optionalString(data, 'label', 100) &&
             optionalTimestamp(data, 'createdAt');
    }

    function isValidMessageLog(data) {
      return data.studentName is string && data.studentName.size() > 0 && data.studentName.size() < 100 &&
             data.year is number &&
             data.month is number &&
             data.templateKey is string && data.templateKey.size() < 30 &&
             data.targetPhone is string && data.targetPhone.size() < 40 &&
             data.message is string && data.message.size() < 5000 &&
             data.action in ['copied', 'sms-opened'] &&
             data.createdAtMs is number &&
             optionalTimestamp(data, 'createdAt');
    }

    function isValidScheduleOperation(data) {
      return data.date is string && data.date.size() > 0 && data.date.size() < 20 &&
             data.studentName is string && data.studentName.size() > 0 && data.studentName.size() < 100 &&
             data.time is string && data.time.size() < 50 &&
             data.status in ['예정', '출석', '결석', '취소', '보강'] &&
             data.note is string && data.note.size() < 2000 &&
             data.updatedAtMs is number &&
             optionalTimestamp(data, 'updatedAt');
    }

    function isValidDocumentTemplate(data) {
      return optionalString(data, 'templateKind', 40) &&
             data.fileName is string && data.fileName.size() > 0 && data.fileName.size() < 255 &&
             data.fileUrl is string && data.fileUrl.size() > 0 && data.fileUrl.size() < 1000 &&
             data.fileType is string && data.fileType.size() > 0 && data.fileType.size() < 20 &&
             data.fileSize is number &&
             data.uploadedAtMs is number &&
             data.applyMode in ['sample-reference', 'hwp-template', 'hwpx-template', 'docx-template'] &&
             optionalString(data, 'storageMode', 40) &&
             optionalString(data, 'chunkUploadId', 80) &&
             optionalNumber(data, 'chunkCount') &&
             optionalNumber(data, 'chunkSize') &&
             optionalString(data, 'notes', 5000) &&
             optionalTimestamp(data, 'updatedAt');
    }

    function isValidTemplateChunk(data) {
      return data.uploadId is string && data.uploadId.size() > 0 && data.uploadId.size() < 80 &&
             data.index is number &&
             data.data is string && data.data.size() <= 800000 &&
             data.size is number;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /students/{studentId} {
      allow read: if singleOperatorMode();
      allow create, update: if singleOperatorMode() && isValidStudent(request.resource.data);
      allow delete: if singleOperatorMode();
    }

    match /payment_records/{recordId} {
      allow read: if singleOperatorMode();
      allow create, update: if singleOperatorMode() && isValidPaymentRecord(request.resource.data);
      allow delete: if singleOperatorMode();
    }

    match /annual_plans/{planId} {
      allow read: if singleOperatorMode();
      allow create, update: if singleOperatorMode() && isValidAnnualPlan(request.resource.data);
      allow delete: if singleOperatorMode();
    }

    match /monthly_journals/{journalId} {
      allow read: if singleOperatorMode();
      allow create, update: if singleOperatorMode() && isValidMonthlyJournal(request.resource.data);
      allow delete: if singleOperatorMode();
    }

    match /document_history/{historyId} {
      allow read: if singleOperatorMode();
      allow create: if singleOperatorMode() && isValidDocumentHistory(request.resource.data);
      allow update, delete: if singleOperatorMode();
    }

    match /message_logs/{logId} {
      allow read: if singleOperatorMode();
      allow create, update: if singleOperatorMode() && isValidMessageLog(request.resource.data);
      allow delete: if singleOperatorMode();
    }

    match /schedule_operation_records/{recordId} {
      allow read: if singleOperatorMode();
      allow create, update: if singleOperatorMode() && isValidScheduleOperation(request.resource.data);
      allow delete: if singleOperatorMode();
    }

    match /document_templates/{templateId} {
      allow read: if singleOperatorMode();
      allow create, update: if singleOperatorMode() && isValidDocumentTemplate(request.resource.data);
      allow delete: if singleOperatorMode();
    }

    match /document_templates/{templateId}/file_chunks/{chunkId} {
      allow read: if singleOperatorMode();
      allow create, update: if singleOperatorMode() && isValidTemplateChunk(request.resource.data);
      allow delete: if singleOperatorMode();
    }

    match /test/connection {
      allow read: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
